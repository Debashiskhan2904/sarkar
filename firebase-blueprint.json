{
  "entities": {
    "jobs": {
      "title": "jobs",
      "description": "Company open career positions",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "dept": { "type": "string" },
        "category": { "type": "string" },
        "loc": { "type": "string" },
        "type": { "type": "string" },
        "exp": { "type": "string" },
        "salary": { "type": "string" },
        "desc": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "dept", "loc", "type"]
    },
    "media": {
      "title": "media",
      "description": "Photos, videos, audios, and official credentials",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "thumb": { "type": "string" },
        "desc": { "type": "string" },
        "sector": { "type": "string" },
        "productSub": { "type": "string" },
        "productLabel": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string" }
      },
      "required": ["type", "title", "url"]
    },
    "applications": {
      "title": "applications",
      "description": "Job candidate submissions",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "position": { "type": "string" },
        "cover": { "type": "string" },
        "fileName": { "type": "string" },
        "fileData": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["name", "email", "position"]
    },
    "inquiries": {
      "title": "inquiries",
      "description": "Contact inquiries and UTR payment verification slips",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "company": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["name", "email", "type"]
    },
    "announcements": {
      "title": "announcements",
      "description": "Website notification banner settings",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "linkText": { "type": "string" },
        "linkUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["active", "text"]
    },
    "chunks": {
      "title": "chunks",
      "description": "Binary or base64 chunked subdocuments for large media storage",
      "type": "object",
      "properties": {
        "index": { "type": "number" },
        "data": { "type": "string" },
        "count": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["index", "data", "count"]
    },
    "settings": {
      "title": "settings",
      "description": "System settings, announcement state, and deleted records tombstones",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "text": { "type": "string" },
        "media": { "type": "array", "items": { "type": "string" } },
        "applications": { "type": "array", "items": { "type": "string" } },
        "inquiries": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      }
    },
    "notices": {
      "title": "notices",
      "description": "Archived live announcements and notices",
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "text": { "type": "string" },
        "category": { "type": "string" },
        "linkText": { "type": "string" },
        "linkUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["text"]
    },
    "audit_logs": {
      "title": "audit_logs",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "adminEmail": { "type": "string" },
        "adminName": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["adminEmail", "action", "timestamp"]
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "jobs",
      "description": "Job openings"
    },
    "/media/{mediaId}": {
      "schema": "media",
      "description": "Media items and catalog assets"
    },
    "/media/{mediaId}/chunks/{chunkId}": {
      "schema": "chunks",
      "description": "Chunked subdocuments for high-capacity media files"
    },
    "/applications/{applicationId}": {
      "schema": "applications",
      "description": "Job candidate applications"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiries",
      "description": "Customer and business inquiries"
    },
    "/announcements/{announcementId}": {
      "schema": "announcements",
      "description": "Announcements and banners"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "System settings and tombstones"
    },
    "/notices/{noticeId}": {
      "schema": "notices",
      "description": "Notices archive"
    },
    "/audit_logs/{logId}": {
      "schema": "audit_logs",
      "description": "Audit trail logs"
    }
  }
}
